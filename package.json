{
  "name": "frozen-rabbit-expert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @frozen-rabbit-expert/web",
    "build": "npm run typecheck && npm run build --workspace @frozen-rabbit-expert/web",
    "typecheck": "vue-tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:solver": "vitest run packages/solver/tests/recommend.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  }
}
